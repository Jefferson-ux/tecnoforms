<div class="lienzo">
      <canvas id="lienzo" width="280" height="280"></canvas>
      <div class="botones">
            <button class="button" id="btn-limpiar" type="button"
                  >Limpiar</button
            >
            <button class="button" id="btn-predecir" type="button"
                  >Predecir</button
            >
      </div>
</div>

<script>
      import { crearLienzo } from "./scripts/canvas";
      import { solicitarPrediccion } from "./scripts/prediccion";

      const lienzo = crearLienzo(
            document.getElementById("lienzo") as HTMLCanvasElement,
      );
      const btnPredecir = document.getElementById(
            "btn-predecir",
      ) as HTMLButtonElement;

      document.getElementById("btn-limpiar")!.addEventListener("click", () => {
            lienzo.limpiar();
            window.dispatchEvent(new CustomEvent("limpiar"));
      });

      btnPredecir.addEventListener("click", async () => {
            const imagen = await lienzo.aBlob();
            if (!imagen) return;

            btnPredecir.disabled = true;
            try {
                  await solicitarPrediccion(imagen);
            } finally {
                  btnPredecir.disabled = false;
            }
      });
</script>

<style>
      .lienzo {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            max-width: 400px;
            margin: auto;
      }
      canvas {
            background: #fff;
            border-radius: 10px;
            cursor:
                  url("lapiz.png") 0 32,
                  crosshair;
            touch-action: none; /* en el celular, dibujar no hace scroll */
            max-width: 100%;
      }
      .botones {
            display: flex;
            margin: 0;
            padding: 0;
            gap: 0.5rem;
      }
      #btn-predecir {
            background: var(--acento);
      }
      button:disabled {
            opacity: 0.5;
            cursor: wait;
      }
</style>
