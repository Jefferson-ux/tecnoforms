---
import Layout from "../layouts/Layout.astro";
---

<Layout>
      <main>
            <h1>Tecno<span>Forms</span></h1>
            <p>
                  Reconocimiento de dígitos manuscritos con una CNN entrenada en
                  MNIST.
            </p>
            <a href="/demo" class="btn">Probar la demo →</a>
      </main>
</Layout>

<style>
      main {
            max-width: 760px;
            margin: 0 auto;
            padding: 5rem 1rem;
            text-align: center;
            color: #e8ecf5;
      }

      h1 {
            font-size: 3rem;
            margin: 0 0 1rem;
      }

      h1 span {
            color: #22d3ee;
      }

      p {
            font-size: 1.2rem;
            color: #9aa4bf;
            margin: 0 0 2rem;
      }

      .btn {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            background: #22d3ee;
            color: #0b1020;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.2s;
      }

      .btn:hover {
            background: #67e8f9;
      }
</style>
